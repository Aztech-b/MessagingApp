// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
    provider = "prisma-client-js"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
}

model User {
    id         Int          @id @default(autoincrement())
    username   String       @unique
    password   String
    messages   Message[]
    chatMember ChatMember[]
}

model Chat {
    id       Int          @id @default(autoincrement())
    title    String
    members  ChatMember[] // I thought about making a chat between users and groups 
    messages Message[] // of users the same thing, but never really implemented group thing
}

model ChatMember {
    userId            Int
    chatId            Int
    lastReadMessageId Int    @default(0)
    color             String @default("white")

    chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@id([userId, chatId])
}

model Message {
    id       Int      @id @default(autoincrement())
    content  String
    authorId Int
    author   User     @relation(fields: [authorId], references: [id])
    chatId   Int
    chat     Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
    sent     DateTime @default(now())
}

model Session {
    sid    String   @id
    sess   Json
    expire DateTime

    @@map("session")
}
